#--------------------------------------------------------------------
# HOSTING ENVIRONMENT — oro3departemen.my.id
# CARA PAKAI: Copy isi file ini ke file .env di server hosting
# WAJIB ganti semua nilai yang ada komentar "GANTI INI"
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'https://oro3departemen.my.id/'
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE — GANTI sesuai info di cPanel > MySQL Databases
# Format username hosting biasanya: namaakun_namadatabase
# Contoh: jika akun cPanel = "oro3dep", maka username = "oro3dep_root"
#--------------------------------------------------------------------

# === DEFAULT / MASTER ===
database.default.hostname = localhost
database.default.database = oro3dep_oromaster
database.default.username = oro3dep_root
database.default.password = GANTI_PASSWORD_HOSTING
database.default.DBDebug   = false

database.master.hostname = localhost
database.master.database = oro3dep_oromaster
database.master.username = oro3dep_root
database.master.password = GANTI_PASSWORD_HOSTING
database.master.DBDebug   = false

# === GUDANG ===
database.gudang.hostname = localhost
database.gudang.database = oro3dep_orogudang
database.gudang.username = oro3dep_root
database.gudang.password = GANTI_PASSWORD_HOSTING
database.gudang.DBDebug   = false

# === PPIC ===
database.ppic.hostname = localhost
database.ppic.database = oro3dep_oroppic
database.ppic.username = oro3dep_root
database.ppic.password = GANTI_PASSWORD_HOSTING
database.ppic.DBDebug   = false

# === PRODUKSI ===
database.produksi.hostname = localhost
database.produksi.database = oro3dep_oroproduksi
database.produksi.username = oro3dep_root
database.produksi.password = GANTI_PASSWORD_HOSTING
database.produksi.DBDebug   = false

# === WAREHOUSE ===
database.warehouse.hostname = localhost
database.warehouse.database = oro3dep_orowarehouse
database.warehouse.username = oro3dep_root
database.warehouse.password = GANTI_PASSWORD_HOSTING
database.warehouse.DBDebug   = false

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
# Jika session file gagal (writable/ tidak bisa ditulis), aktifkan DB handler:
# session.driver = 'CodeIgniter\Session\Handlers\DatabaseHandler'
# session.savePath = ci_sessions

#--------------------------------------------------------------------
# CATATAN PENTING SETELAH UPLOAD
#--------------------------------------------------------------------
# 1. Sesuaikan semua nama database & username dengan yang ada di cPanel
# 2. Pastikan folder writable/ bisa ditulis: chmod 755 writable/ -R
# 3. Jika masih error DB, cek error log di writable/logs/
# 4. DBDebug = false wajib di production agar error DB tidak ditampilkan ke user
